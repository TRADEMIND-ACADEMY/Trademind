# TRADEMIND ACADEMY — variables d'environnement du SERVEUR (à saisir dans Netlify > Site configuration > Environment variables).
# Ne mettez JAMAIS de vraies valeurs dans ce fichier ni dans GitHub. Noms uniquement.
OWNER_SETUP_TOKEN=            # secret long et aléatoire : seul moyen de créer le compte OWNER (serveur uniquement)
PUBLIC_BASE_URL=              # https://VOTRE-SITE.netlify.app
MOBILE_ALLOWED_ORIGINS=       # facultatif : origines supplémentaires de l'app mobile, séparées par des virgules (https://localhost est déjà autorisée)
NOWPAYMENTS_API_KEY=          # facultatif : paiement crypto automatique
NOWPAYMENTS_IPN_SECRET=       # facultatif : signature des notifications NOWPayments
GEMINI_API_KEY=               # facultatif : DAN (assistant IA)
OWNER_NOTIFY_EMAIL=           # facultatif
